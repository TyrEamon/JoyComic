{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joycomic-r2-webdav",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ROOT_PREFIX": "joycomic-webdav"
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "joycomic-backups"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
